generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  CLIENT
}

enum BookingStatus {
  AVAILABLE
  BOOKED
  CANCELLED
  COMPLETED
  BLOCKED
}

enum SessionType {
  INDIVIDUAL
  SGT          // Small Group Training (max 5 clients)
}

enum CreditType {
  INDIVIDUAL
  SGT
}

enum CreditTransactionType {
  ASSIGNED   // teacher/admin adds credits
  DEDUCTED   // booking confirmed, credit spent
  REFUNDED   // booking cancelled, credit returned
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH      // efectivo
  CARD      // tarjeta
  TRANSFER  // transferencia
  BIZUM
  OTHER
}

enum CreditLogAction {
  CREATED
  MARKED_PAID
  MARKED_UNPAID
  PARTIALLY_PAID
  CREDIT_USED
  CREDIT_RESTORED
  ADJUSTED
  CANCELLED
}

enum ClientStatus {
  PENDING    // awaiting admin approval
  ACTIVE     // approved, can book
  REJECTED   // rejected by admin
  SUSPENDED  // temporarily suspended
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(CLIENT)
  // Telegram
  telegramChatId     String?   // required to send messages
  telegramUsername   String?   // @username, informational
  telegramPhone      String?   // phone number, informational
  telegramConnected  Boolean   @default(false)
  telegramToken      String?   // one-time token for deep link connection
  // Avatar
  avatarUrl          String?   // base64 data URL or external URL
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacher              Teacher?
  client               Client?
  createdBookings      Booking[]          @relation("CreatedBy")
  creditTransactions   CreditTransaction[] @relation("CreditCreatedBy")
  creditPackagesCreated ClientCredits[]    @relation("CreditPackageCreatedBy")
  creditLogsPerformed  CreditLog[]         @relation("CreditLogPerformedBy")
}

model Teacher {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  color       String    @default("#f97316")
  bio         String?
  specialties String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  clientCredits     ClientCredits[]
  clientTeachers    ClientTeacher[]
  teacherActivities TeacherActivity[]
  preferringClients Client[]           @relation("ClientPreferredTeacher")
  harbizConnection  TeacherHarbizConnection?
}

// Many-to-many: Teacher <-> Activity
model TeacherActivity {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([teacherId, activityId])
}

model Client {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Onboarding / profile
  status        ClientStatus @default(PENDING)
  lastName      String?
  phone         String?
  goals         String?      // objective or interested activity
  acceptedTerms Boolean      @default(false)
  // Preferences
  preferredActivityId String?
  preferredActivity   Activity? @relation("ClientPreferredActivity", fields: [preferredActivityId], references: [id])
  preferredTeacherId  String?
  preferredTeacher    Teacher?  @relation("ClientPreferredTeacher", fields: [preferredTeacherId], references: [id])
  // Admin notes
  notes         String?
  rejectedReason String?
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings              Booking[]
  credits               ClientCredits[]
  clientTeachers        ClientTeacher[]
  sgtParticipations     BookingParticipant[]
  waitlistEntries       WaitlistEntry[]
  creditLogs            CreditLog[]
}

// Which teachers each client is assigned to (max 2 per client)
model ClientTeacher {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([clientId, teacherId])
}

model Space {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  capacity    Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
}

model Activity {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?
  defaultDuration Int       @default(60)
  maxCapacity     Int       @default(1)
  color           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings              Booking[]
  availabilitySlots     AvailabilitySlot[]
  teacherActivities     TeacherActivity[]
  clientsPreferring     Client[]           @relation("ClientPreferredActivity")
}

model Booking {
  id               String        @id @default(cuid())
  teacherId        String
  teacher          Teacher       @relation(fields: [teacherId], references: [id])
  clientId         String?       // null for SGT (use participants) or AVAILABLE
  client           Client?       @relation(fields: [clientId], references: [id])
  spaceId          String
  space            Space         @relation(fields: [spaceId], references: [id])
  activityId       String
  activity         Activity      @relation(fields: [activityId], references: [id])
  startDatetime    DateTime
  endDatetime      DateTime
  status           BookingStatus @default(AVAILABLE)
  sessionType      SessionType   @default(INDIVIDUAL)
  capacity         Int           @default(1)  // 1 for individual, up to 5 for SGT
  color            String?
  notes            String?
  recurrenceRuleId String?
  recurrenceRule   BookingRecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  createdById      String
  createdBy        User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  notifications NotificationLog[]
  participants  BookingParticipant[]
  waitlist      WaitlistEntry[]
  creditLogs    CreditLog[]

  @@index([startDatetime])
  @@index([teacherId])
  @@index([activityId])
  @@index([spaceId])
  @@index([status])
  @@index([clientId])
}

// For SGT sessions — tracks which clients joined
model BookingParticipant {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([bookingId, clientId])
}

// Waiting list for full sessions
model WaitlistEntry {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  position  Int
  notified  Boolean  @default(false)
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([bookingId, clientId])
}

model BookingRecurrenceRule {
  id         String   @id @default(cuid())
  daysOfWeek Int[]
  startTime  String
  endTime    String
  startDate  DateTime
  endDate    DateTime
  spaceId    String
  activityId String
  teacherId  String
  sessionType SessionType @default(INDIVIDUAL)
  capacity   Int         @default(1)
  createdAt  DateTime @default(now())

  bookings Booking[]
}

model AvailabilitySlot {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id])
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id])
  startDatetime DateTime
  endDatetime   DateTime
  maxCapacity   Int      @default(1)
  minDuration   Int      @default(30)
  maxDuration   Int      @default(120)
  isRecurring   Boolean  @default(false)
  daysOfWeek    Int[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Credits balance per (client, teacher, creditType)
model ClientCredits {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  creditType     CreditType    @default(INDIVIDUAL)
  balance        Int           @default(0)
  totalAssigned  Int           @default(0)   // total credits ever assigned in this package
  expiresAt      DateTime?                   // 6 months from last assignment
  // Payment tracking
  paymentStatus  PaymentStatus @default(UNPAID)
  amountPaid     Float?
  paymentMethod  PaymentMethod?
  paymentDate    DateTime?
  notes          String?
  createdById    String?
  createdBy      User?         @relation("CreditPackageCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions CreditTransaction[]
  creditLogs   CreditLog[]

  @@unique([clientId, teacherId, creditType])
}

model CreditTransaction {
  id              String                @id @default(cuid())
  clientCreditsId String
  clientCredits   ClientCredits         @relation(fields: [clientCreditsId], references: [id], onDelete: Cascade)
  amount          Int                   // positive = add, negative = deduct
  type            CreditTransactionType
  bookingId       String?
  note            String?
  createdById     String
  createdBy       User                  @relation("CreditCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
}

// Detailed audit log for credit operations
model CreditLog {
  id                String          @id @default(cuid())
  clientCreditsId   String
  clientCredits     ClientCredits   @relation(fields: [clientCreditsId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id])
  actionType        CreditLogAction
  previousValueJson Json?           // snapshot before change
  newValueJson      Json?           // snapshot after change
  amount            Int?            // credits affected (positive or negative)
  performedById     String
  performedBy       User            @relation("CreditLogPerformedBy", fields: [performedById], references: [id])
  notes             String?
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([clientId])
  @@index([clientCreditsId])
}

model AppSettings {
  id                      String   @id @default(cuid())
  gymName                 String   @default("Mi Gimnasio")
  logoUrl                 String?
  primaryColor            String   @default("#f97316")
  secondaryColor          String   @default("#ea580c")
  accentColor             String   @default("#fb923c")
  defaultSessionDuration  Int      @default(60)
  openingTime             String   @default("06:00")
  closingTime             String   @default("22:00")
  bookingConfirmationText String   @default("¡Tu reserva ha sido confirmada!")
  cancellationHoursLimit  Int      @default(24)
  cancellationRefundCredits Boolean @default(true)
  creditExpiryMonths      Int      @default(6)
  sgtMaxClients           Int      @default(5)
  // Client onboarding
  requireAdminApproval    Boolean  @default(true)
  telegramBotName         String?  // e.g. "GymBookBot" for deep links
  updatedAt               DateTime @updatedAt
}

model TelegramSettings {
  id            String   @id @default(cuid())
  botToken      String?
  botName       String?  // e.g. "GymBookBot"
  adminChatId   String?
  notifyAdmin   Boolean  @default(true)
  notifyTeacher Boolean  @default(true)
  notifyClient  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  type      String
  recipient String
  message   String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())
}

// Relation helpers needed for Client preferred teacher
// (stored as direct fields above, no extra model needed)

// ─── Harbiz Integration ──────────────────────────────────────────────────────

model TeacherHarbizConnection {
  id           String    @id @default(cuid())
  teacherId    String    @unique
  teacher      Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  harbizProfId String?                   // Meteor userId del profesional en Harbiz
  lastSyncAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  syncLogs     ExternalSyncLog[]

  @@index([teacherId])
}

model ExternalIdMapping {
  id          String   @id @default(cuid())
  entityType  String   // "CLIENT" | "BOOKING" | "CREDIT"
  gymBookId   String
  externalId  String   // Meteor _id en Harbiz
  source      String   @default("HARBIZ")
  createdAt   DateTime @default(now())

  @@unique([entityType, externalId, source])
  @@unique([entityType, gymBookId, source])
  @@index([entityType, gymBookId])
  @@index([entityType, externalId])
}

model ExternalSyncLog {
  id              String                   @id @default(cuid())
  connectionId    String
  connection      TeacherHarbizConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncType        String                   @default("FULL")
  status          String                   @default("PENDING") // PENDING | DRY_RUN_OK | COMPLETED | FAILED
  dryRun          Boolean                  @default(true)
  clientsFound    Int                      @default(0)
  clientsCreated  Int                      @default(0)
  clientsUpdated  Int                      @default(0)
  sessionsFound   Int                      @default(0)
  sessionsCreated Int                      @default(0)
  packsFound      Int                      @default(0)
  packsCreated    Int                      @default(0)
  errors          Json?
  diffJson        Json?
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?

  @@index([connectionId])
  @@index([startedAt])
}
