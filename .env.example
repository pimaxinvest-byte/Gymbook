# =============================================
# GymBook NXT - Variables de Entorno
# =============================================
# Copia este archivo como .env o .env.local y rellena los valores reales.
# NUNCA subas archivos .env* con secretos reales a git.

# ─────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────
# Usa PostgreSQL (Railway recomendado para producción)
DATABASE_URL="postgresql://usuario:password@host:puerto/dbname?schema=public&connection_limit=10"

# Ejemplo local (Supabase, Railway, o Postgres local)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymbook_nxt?schema=public"

# ─────────────────────────────────────────────
# NextAuth.js (obligatorio)
# ─────────────────────────────────────────────
# Genera un secreto fuerte:
#   openssl rand -base64 32
NEXTAUTH_SECRET="genera-una-clave-segura-muy-larga-aqui"
NEXTAUTH_URL="http://localhost:3000"
# En producción (Railway):
# NEXTAUTH_URL="https://tu-app.up.railway.app"

# ─────────────────────────────────────────────
# URLs públicas (accesibles desde el navegador)
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción:
# NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# ─────────────────────────────────────────────
# Telegram Bot (recomendado)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_NAME="GymBookBot"

# Nombre público que se usa en el frontend (deep links, etc.)
NEXT_PUBLIC_TELEGRAM_BOT_NAME="GymBookBot"

# Chat ID de admin para notificaciones (opcional pero útil)
TELEGRAM_ADMIN_CHAT_ID=""

# ─────────────────────────────────────────────
# Cron / Endpoints protegidos
# ─────────────────────────────────────────────
# Secreto para proteger /api/cron/* (recomendado en producción)
CRON_SECRET="un-secreto-largo-para-cron-jobs"

# ─────────────────────────────────────────────
# Integración Harbiz (opcional)
# ─────────────────────────────────────────────
# Solo si usas la sincronización con Harbiz
# HARBIZ_EMAIL="tu-email@harbiz.com"
# HARBIZ_PASSWORD="tu-password-harbiz"

# ─────────────────────────────────────────────
# Desarrollo y semillas
# ─────────────────────────────────────────────
# NODE_ENV se establece automáticamente (development | production)
# Activa datos de demostración en el seed:
# SEED_DEMO="true"

# ─────────────────────────────────────────────
# Notas
# ─────────────────────────────────────────────
# - .env.local tiene prioridad en desarrollo local.
# - En Railway / producción, configura las variables en el dashboard.
# - Después de cambiar DATABASE_URL: npx prisma generate
# - Primera vez / reset de datos: npm run db:seed
